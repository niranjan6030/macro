# ---------------------------------------------------------------------
# MACRO — environment
#
# Copy to .env.local and fill in what you have. The app degrades rather
# than breaks: with none of this it still builds and runs, and each
# feature switches on as soon as its keys appear. The README says which
# feature each block unlocks.
# ---------------------------------------------------------------------

# --- Site address ----------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 1. Firebase Authentication --------------------------------------
# Unlocks: signing in at all.
# Firebase console → Project settings → General → Your apps → Web app.
# These are public by design. Firebase's security comes from the
# authorised-domains list and the rules, not from hiding the config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only — verifies the session cookie on every API call.
# Project settings → Service accounts → Generate new private key.
# Either paste the whole JSON on one line:
FIREBASE_SERVICE_ACCOUNT=
# …or set the three fields separately (keep the \n sequences in the key):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local development against the Auth emulator, so the whole sign-in flow
# can be exercised before any real Firebase project exists.
# Run `npm run emulator` in another terminal, then uncomment both:
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- 2. Supabase (database + photo storage) --------------------------
# Unlocks: everything that is saved. Without it the app can compute
# targets but cannot remember anything.
# Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security — never expose this.
# Identity is Firebase's, so route handlers scope every query by uid
# themselves; see the note at the top of supabase/schema.sql.
SUPABASE_SERVICE_ROLE_KEY=

# --- 3. Anthropic (photo recognition + weekly review) ----------------
# Unlocks: photographing a meal, and the written weekly review.
# Without it, search and barcode logging work exactly as well, and the
# review still reports your figures — it is just not written up.
# console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5, which is the right balance for
# a per-photo cost. Use claude-opus-5 for harder identification.
ANTHROPIC_MODEL=

# --- 4. USDA FoodData Central (whole foods) --------------------------
# Unlocks: laboratory-measured values for unpackaged food. Highly
# recommended — it is free and it is the most accurate source there is.
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
# Without it, Open Food Facts and the built-in Indian table still work.
USDA_API_KEY=

# Open Food Facts needs no key and is always on.
