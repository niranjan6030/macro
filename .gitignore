# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
web/.next/
web/out/
web/build/
web/next-env.d.ts

# The compiled copy of the domain modules that `npm run check` exercises.
web/.check/

# Environment — .env.example is tracked, the real values are never
.env
.env.local
.env*.local
!.env.example

# Native shells.
#
# ios/ and android/ are generated by `npx cap add` and are tracked, because
# the permission strings and signing config live in them and are part of the
# app. Their build output is not.
web/ios/App/Pods/
web/ios/App/App/public/
web/ios/App/build/
web/ios/DerivedData/
web/android/build/
web/android/app/build/
web/android/.gradle/
web/android/local.properties
web/android/app/release/
web/android/capacitor-cordova-android-plugins/
*.keystore
!debug.keystore

# Deployment
.vercel

# macOS
.DS_Store
*.swp

# Incremental TypeScript build cache
web/*.tsbuildinfo

# Generated by `next build` on every run
web/AGENTS.md
web/CLAUDE.md
